# Copie este arquivo para ".env" (na mesma pasta) e cole sua chave da Riot.
# O arquivo .env nunca vai pro GitHub.
RIOT_API_KEY=RGAPI-cole-sua-chave-aqui

# Porta local do servidor (o túnel aponta pra ela).
PORT=8787

# Sites que podem usar o servidor, separados por vírgula.
ALLOWED_ORIGINS=https://silviop301.github.io
